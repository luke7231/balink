# Database (Cloudtype Postgres)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres

# GraphQL API (apps/api) — full URL including /graphql
# Local: http://localhost:3000/graphql
# Production: https://YOUR_API_HOST/graphql
API_URL=http://localhost:3000/graphql

# Auth.js
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3100

# Kakao Login (developers.kakao.com)
# Redirect URI: http://localhost:3100/api/auth/callback/kakao
# Production: https://YOUR_VERCEL_DOMAIN/api/auth/callback/kakao
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=

# Apple Sign In (optional until enabled)
# Return URL: https://YOUR_DOMAIN/api/auth/callback/apple
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# S3 profile images (optional)
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PUBLIC_BASE_URL=
