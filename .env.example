# Database (Cloudtype Postgres)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres

# GraphQL API (apps/api) — full URL including /graphql
# Local: http://localhost:3000/graphql
# Production: https://YOUR_API_HOST/graphql
API_URL=http://localhost:3000/graphql

# Auth.js
AUTH_SECRET=generate-with-openssl-rand-base64-32
# Production: https://www.balink.co.kr
AUTH_URL=http://localhost:3100

# Kakao Login (developers.kakao.com)
# Redirect URI: http://localhost:3100/api/auth/callback/kakao
# Production: https://www.balink.co.kr/api/auth/callback/kakao
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=
# Kakao JavaScript SDK + channel chat (public browser values)
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=
NEXT_PUBLIC_KAKAO_CHANNEL_PUBLIC_ID=
# Kakao native app key (iOS/Android 앱 키). 실기기 카카오톡 로그인 복귀에 필요
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=

# Apple Sign In (optional until enabled)
# Return URL: https://www.balink.co.kr/api/auth/callback/apple
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# Resend (email change verification)
RESEND_API_KEY=
# Optional override. Default: 발링크 <noreply@balink.co.kr>
RESEND_FROM_EMAIL=

# S3 profile images (optional)
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PUBLIC_BASE_URL=

# Expo mobile app
# Local Metro/dev-client: leave unset to auto-use http://<LAN-IP>:3100
# Production / EAS: https://www.balink.co.kr
EXPO_PUBLIC_WEB_URL=
EXPO_PROJECT_ID=

# Expo push worker (server only)
EXPO_ACCESS_TOKEN=
PUSH_DISPATCH_ENABLED=false
PUSH_DISPATCH_INTERVAL_SECONDS=30
PUSH_RECEIPT_INTERVAL_MINUTES=15
PUSH_DISPATCH_BATCH_SIZE=100
PUSH_RECEIPT_BATCH_SIZE=300
PUSH_MAX_ATTEMPTS=5
ANONYMOUS_URGENT_PUSH_ENABLED=true
ANONYMOUS_DAILY_DIGEST_ENABLED=true
ANONYMOUS_DAILY_DIGEST_HOUR_KST=19
