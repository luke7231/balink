{
  "name": "@black-swan/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "worker": "node dist/server.js",
    "dev": "pnpm run build && pnpm run worker",
    "start": "node ../../scripts/wait-for-db.js && pnpm --filter @black-swan/db migrate:deploy && pnpm run worker",
    "collect:balletmania": "node scripts/collect-balletmania-employ-list.cjs",
    "classify:balletmania": "node scripts/classify-balletmania-employ-details.cjs",
    "collect:esangdance": "node scripts/collect-esangdance-employ-list.cjs",
    "classify:esangdance": "node scripts/classify-esangdance-employ-details.cjs",
    "verify:deps": "node scripts/verify-runtime-deps.cjs"
  },
  "dependencies": {
    "@black-swan/db": "workspace:*",
    "@black-swan/domain": "workspace:*",
    "@black-swan/validation": "workspace:*",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "iconv-lite": "^0.6.3",
    "openai": "^6.42.0",
    "undici": "^8.9.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "typescript": "^6.0.3"
  }
}
