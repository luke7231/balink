{
  "name": "@balink/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "worker": "node dist/server.js",
    "dev": "pnpm run build && pnpm run worker",
    "start": "node ../../scripts/wait-for-db.js && pnpm --filter @balink/db migrate:deploy && pnpm run worker",
    "collect:balletmania": "node scripts/collect-balletmania-employ-list.cjs",
    "classify:balletmania": "node scripts/classify-balletmania-employ-details.cjs",
    "collect:esangdance": "node scripts/collect-esangdance-employ-list.cjs",
    "classify:esangdance": "node scripts/classify-esangdance-employ-details.cjs",
    "backfill:existing-descriptions": "node scripts/backfill-existing-descriptions.cjs",
    "backfill:formatted": "pnpm run build && node dist/backfill-formatted.js",
    "backfill:schedules": "pnpm run build && node dist/backfill-schedules.js",
    "backfill:organizations": "pnpm run build && node dist/backfill-organizations.js",
    "backfill:region-aliases": "pnpm run build && node dist/backfill-region-aliases.js",
    "collect:balletmania-working": "node scripts/collect-balletmania-working-list.cjs",
    "classify:balletmania-working": "node scripts/classify-balletmania-working-details.cjs",
    "backfill:substitutes": "pnpm run build && node dist/backfill-substitutes.js",
    "backfill:substitutes-all": "pnpm run build && node dist/backfill-substitutes-all.js",
    "backfill:employ-substitutes": "pnpm run build && node dist/backfill-employ-substitutes.js",
    "verify:deps": "node scripts/verify-runtime-deps.cjs",
    "push:test": "pnpm run build && node dist/push-test.js",
    "test": "pnpm run build && node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.888.0",
    "@balink/db": "workspace:*",
    "@balink/domain": "workspace:*",
    "@balink/validation": "workspace:*",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "expo-server-sdk": "^7.1.0",
    "iconv-lite": "^0.6.3",
    "openai": "^6.42.0",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "typescript": "^6.0.3"
  }
}
