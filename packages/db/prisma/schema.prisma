generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SourceName {
  balletmania
  esangdance
}

enum ScraperRunStatus {
  running
  success
  failed
}

enum SubstitutePostStatus {
  OPEN
  EXPIRED
  DELETED
}

model SourcePost {
  id                 String          @id @default(cuid())
  source             SourceName
  sourcePostId       String
  sourceUrl          String
  title              String
  postedAt           DateTime?
  rawJson            Json
  classificationJson Json?
  contentHash        String?
  fetchedAt          DateTime        @default(now())
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  jobPostSources     JobPostSource[]

  @@unique([source, sourcePostId])
  @@index([source, postedAt])
  @@index([contentHash])
}

model JobPost {
  id                String          @id @default(cuid())
  title             String
  description       String?
  sourcePrimary     SourceName
  status            String?
  postedAt          DateTime?
  jobType           String?
  isBallet          Boolean         @default(false)
  balletConfidence  String?
  audienceTypes     Json
  subjectTypes      Json
  locationText      String?
  sido              String?
  sigungu           String?
  dongOrStation     String?
  days              Json
  timeSlots         Json
  times             Json
  classCount        Int?
  durationMinutes   Int?
  payType           String?
  payMinManwon      Float?
  payMaxManwon      Float?
  payText           String?
  payNegotiable     Boolean         @default(false)
  displaySectionsJson Json?
  representativePayUnit String?
  representativePayText String?
  representativePayMinManwon Float?
  representativePayMaxManwon Float?
  representativePayJson Json?
  locationSource    String?
  academyLogoUrl    String?
  academyGalleryJson Json?
  contactMethods    Json
  contactEmails     Json
  contactPhones     Json
  requirementsJson  Json
  confidenceJson    Json?
  normalizedJson    Json
  contentHash       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  jobPostSources    JobPostSource[]

  @@index([postedAt])
  @@index([sourcePrimary])
  @@index([contentHash])
}

model JobPostSource {
  id           String     @id @default(cuid())
  jobPostId    String
  sourcePostId String
  source       SourceName
  sourceUrl    String
  confidence   String?
  createdAt    DateTime   @default(now())
  jobPost      JobPost    @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  sourcePost   SourcePost @relation(fields: [sourcePostId], references: [id], onDelete: Cascade)

  @@unique([jobPostId, sourcePostId])
  @@index([source, sourceUrl])
}

model SubstitutePost {
  id                       String               @id @default(cuid())
  source                   SourceName
  sourcePostId             String
  sourceUrl                String
  title                    String
  summary                  String?
  body                     String?
  author                   String?
  authorMemberNo           String?
  postedAt                 DateTime?
  sessionsJson             Json                 @default("[]")
  recurrenceJson           Json?
  scheduleKind             String               @default("unscheduled")
  lessonDatesJson          Json
  timeSlotsJson            Json
  audienceTypes            Json
  subjectTypes             Json
  locationText             String?
  sido                     String?
  sigungu                  String?
  dongOrStation            String?
  payText                  String?
  representativePayJson    Json?
  representativePayText    String?
  academyName              String?
  requirementsJson         Json                 @default("[]")
  applicationInstructions  String?
  notesJson                Json                 @default("[]")
  contactMethodsJson       Json
  contactEmailsJson        Json
  contactPhonesJson        Json
  urgency                  String?
  status                   SubstitutePostStatus @default(OPEN)
  nextLessonAt             DateTime?
  expiresAt                DateTime?
  recommendCount           Int                  @default(0)
  viewCount                Int                  @default(0)
  rawJson                  Json
  classificationJson       Json?
  contentHash              String?
  normalizationVersion     Int                  @default(0)
  normalizedAt             DateTime?
  lastSeenAt               DateTime             @default(now())
  lastDeletionCheckAt      DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  @@unique([source, sourcePostId])
  @@index([status, nextLessonAt])
  @@index([status, postedAt])
  @@index([status, expiresAt])
  @@index([contentHash])
}

model ScraperRun {
  id           String           @id @default(cuid())
  source       SourceName?
  targetDate   String
  llmMode      String
  status       ScraperRunStatus @default(running)
  startedAt    DateTime         @default(now())
  finishedAt   DateTime?
  collected    Int              @default(0)
  classified   Int              @default(0)
  imported     Int              @default(0)
  errorMessage String?
  logs         Json?
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}
