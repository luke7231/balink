generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SourceName {
  balletmania
  esangdance
}

enum ScraperRunStatus {
  running
  success
  failed
}

enum SubstitutePostStatus {
  OPEN
  EXPIRED
  DELETED
}

enum PushPlatform {
  ios
  android
}

enum PushPermissionStatus {
  granted
  denied
  undetermined
  unavailable
}

enum PushDeliveryStatus {
  pending
  processing
  ticketed
  delivered
  retrying
  failed
}

enum PushReceiptStatus {
  pending
  ok
  error
}

enum OrganizationType {
  ACADEMY
  DISPATCH_AGENCY
  UNKNOWN
}

model Organization {
  id                String           @id @default(cuid())
  name              String
  normalizedName    String
  type              OrganizationType @default(UNKNOWN)
  /// 보수적 중복 방지 키. 예: "normalizedName|sido|sigungu" 또는 외부 프로필/연락처 기반 키
  matchKey          String           @unique
  sido              String?
  sigungu           String?
  dongOrStation     String?
  phonesJson        Json             @default("[]")
  emailsJson        Json             @default("[]")
  logoUrl           String?
  galleryJson       Json             @default("[]")
  externalProfileUrl String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  jobPosts          JobPost[]

  @@index([normalizedName])
  @@index([sido, sigungu])
  @@index([type])
}

model SourcePost {
  id                 String          @id @default(cuid())
  source             SourceName
  sourcePostId       String
  sourceUrl          String
  title              String
  postedAt           DateTime?
  rawJson            Json
  classificationJson Json?
  contentHash        String?
  fetchedAt          DateTime        @default(now())
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  jobPostSources     JobPostSource[]

  @@unique([source, sourcePostId])
  @@index([source, postedAt])
  @@index([contentHash])
}

model JobPost {
  id                String          @id @default(cuid())
  title             String
  description       String?
  sourcePrimary     SourceName
  status            String?
  postedAt          DateTime?
  jobType           String?
  isBallet          Boolean         @default(false)
  balletConfidence  String?
  audienceTypes     Json
  subjectTypes      Json
  locationText      String?
  sido              String?
  sigungu           String?
  dongOrStation     String?
  days              Json
  /// string[][] — 대안 요일 묶음 예: [["수","금"],["월","수"]]
  dayGroups         Json            @default("[]")
  timeSlots         Json
  times             Json
  classCount        Int?
  durationMinutes   Int?
  payType           String?
  payMinManwon      Float?
  payMaxManwon      Float?
  payText           String?
  payNegotiable     Boolean         @default(false)
  displaySectionsJson Json?
  representativePayUnit String?
  representativePayText String?
  representativePayMinManwon Float?
  representativePayMaxManwon Float?
  representativePayJson Json?
  locationSource    String?
  academyLogoUrl    String?
  academyGalleryJson Json?
  organizationId    String?
  contactMethods    Json
  contactEmails     Json
  contactPhones     Json
  requirementsJson  Json
  confidenceJson    Json?
  normalizedJson    Json
  contentHash       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  organization      Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  jobPostSources    JobPostSource[]
  bookmarks         JobBookmark[]

  @@index([postedAt])
  @@index([sourcePrimary])
  @@index([contentHash])
  @@index([organizationId])
}

model JobPostSource {
  id           String     @id @default(cuid())
  jobPostId    String
  sourcePostId String
  source       SourceName
  sourceUrl    String
  confidence   String?
  createdAt    DateTime   @default(now())
  jobPost      JobPost    @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  sourcePost   SourcePost @relation(fields: [sourcePostId], references: [id], onDelete: Cascade)

  @@unique([jobPostId, sourcePostId])
  @@index([source, sourceUrl])
}

model SubstitutePost {
  id                       String               @id @default(cuid())
  source                   SourceName
  sourcePostId             String
  sourceUrl                String
  title                    String
  summary                  String?
  body                     String?
  author                   String?
  authorMemberNo           String?
  postedAt                 DateTime?
  sessionsJson             Json                 @default("[]")
  recurrenceJson           Json?
  scheduleKind             String               @default("unscheduled")
  lessonDatesJson          Json
  timeSlotsJson            Json
  audienceTypes            Json
  subjectTypes             Json
  locationText             String?
  sido                     String?
  sigungu                  String?
  dongOrStation            String?
  payText                  String?
  representativePayJson    Json?
  representativePayText    String?
  academyName              String?
  requirementsJson         Json                 @default("[]")
  applicationInstructions  String?
  notesJson                Json                 @default("[]")
  contactMethodsJson       Json
  contactEmailsJson        Json
  contactPhonesJson        Json
  urgency                  String?
  status                   SubstitutePostStatus @default(OPEN)
  nextLessonAt             DateTime?
  expiresAt                DateTime?
  recommendCount           Int                  @default(0)
  viewCount                Int                  @default(0)
  rawJson                  Json
  classificationJson       Json?
  contentHash              String?
  normalizationVersion     Int                  @default(0)
  normalizedAt             DateTime?
  lastSeenAt               DateTime             @default(now())
  lastDeletionCheckAt      DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  bookmarks                SubstituteBookmark[]

  @@unique([source, sourcePostId])
  @@index([status, nextLessonAt])
  @@index([status, postedAt])
  @@index([status, expiresAt])
  @@index([contentHash])
}

model ScraperRun {
  id           String           @id @default(cuid())
  source       SourceName?
  targetDate   String
  llmMode      String
  status       ScraperRunStatus @default(running)
  startedAt    DateTime         @default(now())
  finishedAt   DateTime?
  collected    Int              @default(0)
  classified   Int              @default(0)
  imported     Int              @default(0)
  errorMessage String?
  logs         Json?
}

model User {
  id               String               @id @default(cuid())
  name             String?
  email            String?              @unique
  emailVerified    DateTime?
  /// scrypt hash; null for social-only accounts
  passwordHash     String?
  image            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  accounts         Account[]
  sessions         Session[]
  interestRegions           UserInterestRegion[]
  jobBookmarks              JobBookmark[]
  substituteBookmarks       SubstituteBookmark[]
  notificationPreference    UserNotificationPreference?
  notifications             UserNotification[]
  pushDevices               PushDevice[]
  emailChangeRequests       EmailChangeRequest[]
}

model EmailChangeRequest {
  id        String   @id @default(cuid())
  userId    String
  newEmail  String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

enum EmailAuthPurpose {
  signup
  reset
}

/// Pending email OTP before User exists (signup) or before password reset/attach.
model EmailAuthChallenge {
  id           String           @id @default(cuid())
  email        String
  purpose      EmailAuthPurpose
  codeHash     String
  expiresAt    DateTime
  verifiedAt   DateTime?
  attemptCount Int              @default(0)
  sentAt       DateTime         @default(now())
  createdAt    DateTime         @default(now())

  @@index([email, purpose, createdAt])
  @@index([expiresAt])
}

/// Rate limit windows for login attempts and OTP sends.
model AuthThrottle {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(0)
  windowStart DateTime
  lockedUntil DateTime?
  updatedAt DateTime @updatedAt

  @@index([lockedUntil])
}

enum UserNotificationType {
  job_match
  substitute_match
  system
}

model UserNotification {
  id               String               @id @default(cuid())
  userId           String
  type             UserNotificationType
  title            String
  body             String
  href             String?
  jobPostId        String?
  substitutePostId String?
  readAt           DateTime?
  createdAt        DateTime             @default(now())
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushMessage      PushMessage?

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model PushDevice {
  id                     String               @id @default(cuid())
  userId                 String?
  expoPushToken          String?              @unique
  installationId         String               @unique
  installationSecretHash String
  platform               PushPlatform
  enabled                Boolean              @default(true)
  permissionStatus       PushPermissionStatus @default(undetermined)
  canAskAgain            Boolean              @default(true)
  permissionUpdatedAt    DateTime              @default(now())
  lastSeenAt             DateTime              @default(now())
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  user                   User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  deliveries             PushDelivery[]

  @@index([userId, enabled, permissionStatus])
  @@index([enabled, permissionStatus])
}

model PushMessage {
  id                 String            @id @default(cuid())
  dedupeKey          String            @unique
  userNotificationId String?           @unique
  kind               String
  title              String
  body               String
  href               String?
  createdAt          DateTime          @default(now())
  userNotification   UserNotification? @relation(fields: [userNotificationId], references: [id], onDelete: Cascade)
  deliveries         PushDelivery[]
}

model PushDelivery {
  id             String                @id @default(cuid())
  pushMessageId  String
  pushDeviceId   String
  status         PushDeliveryStatus    @default(pending)
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime              @default(now())
  claimedAt      DateTime?
  expoTicketId   String?               @unique
  receiptStatus  PushReceiptStatus?
  lastError      String?
  sentAt         DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  pushMessage    PushMessage           @relation(fields: [pushMessageId], references: [id], onDelete: Cascade)
  pushDevice     PushDevice            @relation(fields: [pushDeviceId], references: [id], onDelete: Cascade)

  @@unique([pushMessageId, pushDeviceId])
  @@index([status, nextAttemptAt])
  @@index([receiptStatus, sentAt])
}

model UserNotificationPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  enabled   Boolean  @default(true)
  /// NotificationRule[] — 지역·유형·요일·시간대를 묶은 알림 규칙
  rulesJson Json     @default("[]")
  /// @deprecated rulesJson으로 대체. 읽기 마이그레이션용
  regularJson    Json @default("{}")
  /// @deprecated rulesJson으로 대체. 읽기 마이그레이션용
  substituteJson Json @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserInterestRegion {
  id        String   @id @default(cuid())
  userId    String
  sido      String
  sigungu   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sido, sigungu])
  @@index([userId])
}

model JobBookmark {
  id        String   @id @default(cuid())
  userId    String
  jobPostId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPost   JobPost  @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  @@unique([userId, jobPostId])
  @@index([userId, createdAt])
  @@index([jobPostId])
}

model SubstituteBookmark {
  id               String         @id @default(cuid())
  userId           String
  substitutePostId String
  createdAt        DateTime       @default(now())
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  substitutePost   SubstitutePost @relation(fields: [substitutePostId], references: [id], onDelete: Cascade)

  @@unique([userId, substitutePostId])
  @@index([userId, createdAt])
  @@index([substitutePostId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}
